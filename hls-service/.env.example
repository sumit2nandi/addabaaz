# ---------------------------------------------------------------------------
# ADDABAAZ HLS converter — configuration
#
#   cp .env.example .env      (then edit)
#   node --env-file=.env src/index.js      # Node 20.6+ ; or export the values
#
# The service does NOT read .env by itself — same rule as the main app.
# ---------------------------------------------------------------------------

# --- portal / API -----------------------------------------------------------------
PORT=8080
# Shared secret for the API and the portal (REQUIRED, at least 24 characters).
# The portal asks for it once and remembers it in the browser. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CONVERTER_TOKEN=

# Where job state, staged uploads and encoded packages are kept.
# Use a disk with room for at least 3x the largest source video.
DATA_DIR=./data

# How many videos are converted at the same time (1 is right for most machines —
# each job already uses every core it can). Raise it only on a big server.
CONCURRENCY=1
# Decide which quality ladder a source gets. `auto` = every rung the video can fill
# (auto | full | hd | mobile | fast | source). MAX_SHORT_SIDE caps the top rung.
DEFAULT_PRESET=auto
MAX_SHORT_SIDE=1080
# Threads ffmpeg may use per job (0 = all cores).
FFMPEG_THREADS=0
# Stop accepting uploads above this size (GB, per file; minimum 0.001 = 1 MB).
MAX_UPLOAD_GB=16
# Keep the finished package on disk for this many hours (the portal can download it as a ZIP).
LOCAL_RETENTION_HOURS=48
# Delete the local package right after a successful upload to R2 (0/1). Off by default so
# you can still download or re-upload; the retention sweeper cleans up later anyway.
DELETE_LOCAL_AFTER_UPLOAD=0
# Fail a job when ffmpeg reports no progress for this long (seconds).
STALL_SECONDS=300

# --- ffmpeg -----------------------------------------------------------------------
# Leave empty to use `ffmpeg`/`ffprobe` from PATH (or the copies in ./.tools — `npm run get:ffmpeg`).
FFMPEG_PATH=
FFPROBE_PATH=

# --- Cloudflare R2 (the destination for the HLS output) ---------------------------
# Same names as the main app; this token needs Object READ + WRITE (unlike the read-only
# token the website uses) because the service PUTs the encoded files.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# R2_ENDPOINT=                                      # optional override (any S3-compatible store)
# Prefix every package is written under: <R2_PREFIX>/<slug>/master.m3u8
R2_PREFIX=premium
# Optional public/custom-domain base for the bucket, only used to print a playable link:
# R2_PUBLIC_BASE_URL=https://cdn.addabaaz.in

# --- optional: publish straight into the ADDABAAZ catalog --------------------------
# Set BOTH to let the portal attach a finished HLS key to an existing video in your
# site's catalog (Admin console API, ADMIN_TOKEN from the main app).
# APP_API_URL=https://addabaaz.example.com
# APP_ADMIN_TOKEN=

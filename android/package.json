{
  "name": "addabaaz-android",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-mobile.mjs",
    "preview": "npm run build && http-server www -a 0.0.0.0 -p 3001 -c-1",
    "sync": "npm run build && cap sync android",
    "open": "npm run sync && cap open android",
    "debug": "npm run sync && cd native && ./gradlew assembleDebug",
    "test": "npm run build && playwright test",
    "icons": "node scripts/android-icons.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@playwright/test": "1.56.1",
    "esbuild": "0.28.2",
    "http-server": "14.1.1",
    "sharp": "0.35.4",
    "exceljs": "4.4.0"
  }
}

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=addabaaz
DB_USER=addabaaz
DB_PASSWORD=
# Generate with: openssl rand -hex 32. Keep private, never ship to clients.
ADMIN_TOKEN=
PORT=3000
# Public web origins (if separately hosted) + native origins. No wildcard.
CORS_ORIGINS=https://app.addabaaz.in,capacitor://app.addabaaz.in
# Set ONLY to the exact number of trusted reverse proxy hops, usually 1.
TRUST_PROXY_HOPS=0
# Optional path to your managed MySQL CA certificate for verified TLS:
DB_SSL_CA=

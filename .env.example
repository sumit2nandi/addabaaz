# Copy to .env (never commit). Load with your process manager / docker --env-file.
PORT=3000
NODE_ENV=production
JWT_SECRET=change-me-to-a-long-random-string      # openssl rand -hex 32   (REQUIRED in production)

# ---- MySQL (5.7+ or 8.x) ----
DATABASE_URL=mysql://addabaaz:change-me@127.0.0.1:3306/addabaaz
# ...or individual settings instead of DATABASE_URL:
# DB_HOST=127.0.0.1                                # Hostinger Web App: use 127.0.0.1 (not localhost) and the names from hPanel → Databases
# DB_PORT=3306
# DB_USER=addabaaz
# DB_PASSWORD=change-me
# DB_NAME=addabaaz
# DB_SSL=true                # managed MySQL (RDS, Cloud SQL, Azure, PlanetScale...); DB_SSL_VERIFY=false to skip CA verification (not recommended)
# DB_SSL_CA_FILE=/etc/secrets/aiven-ca.pem   # private CA certificate (Aiven): file path, or DB_SSL_CA="-----BEGIN CERTIFICATE-----..." as text
# DB_POOL_SIZE=10                                  # shared hosting: use 3-5 (per-user connection limits)
# DB_CREATE=false            # true = CREATE DATABASE IF NOT EXISTS on start (needs that privilege)
# DB_MIGRATE=true            # false = don't auto-migrate on start; run `npm run db:migrate` in your deploy pipeline instead

# ---- Manual full-channel YouTube catalog preview (fetched only after an admin click) ----
# Defaults to @ADDABAAZ01; override with another permanent channel ID if needed.
YOUTUBE_CHANNEL_ID=UCdG8idFz3zA7xOaca8H6qtw
# Google Cloud Console → enable YouTube Data API v3 → create a key; keep it server-side and restrict it to this API.
YOUTUBE_API_KEY=

# ---- Social sign-in (leave blank to disable a provider) — see docs/AUTH.md ----
GOOGLE_CLIENT_ID=                                  # OAuth "Web application" client id (also used by the website button)
GOOGLE_IOS_CLIENT_ID=                              # optional: OAuth iOS client id (native app)
GOOGLE_EXTRA_CLIENT_IDS=                           # optional: more accepted audiences, comma separated (e.g. Android client id)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=                               # server-side only, never ship to clients
FACEBOOK_CLIENT_TOKEN=                             # optional: only needed by the native apps
# FACEBOOK_GRAPH_VERSION=v21.0

# ---- Optional private video storage in Cloudflare R2 (including Premium titles that need file protection) — see docs/PREMIUM.md ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=                                  # API token with "Object Read only" on the bucket
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# R2_ENDPOINT=                                     # optional override (defaults to https://<account>.r2.cloudflarestorage.com)
STREAM_URL_TTL=21600                               # seconds a signed video URL stays valid (default 6 h)
PUBLIC_API_URL=                                    # public https URL of this API (needed for HLS behind a proxy), e.g. https://api.addabaaz.in

CORS_ORIGINS=*                                     # or https://addabaaz.in,https://app.addabaaz.in
# IMAGE_ALLOWED_HOSTS=                              # extra hosts whose pages may show /media and /uploads images (comma-separated). Always allowed: this server, PUBLIC_SITE_URL (+ www), CORS_ORIGINS entries and the native app (app.addabaaz.in)
TRUST_PROXY=1                                      # number of reverse proxies in front of the app

# ---- Payments (Razorpay, INR) — premium video needs sign-in AND an active paid plan ----
RAZORPAY_KEY_ID=                                   # dashboard → Settings → API Keys (rzp_test_… while testing, rzp_live_… in production)
RAZORPAY_KEY_SECRET=                               # server-side only, never ship to the browser
RAZORPAY_WEBHOOK_SECRET=                           # dashboard → Webhooks → https://<api>/api/v1/payments/webhook, event payment.captured
# Without Razorpay keys: development uses an instant, clearly-labelled DEMO checkout; production has NO checkout (501) unless you set:
# ALLOW_MOCK_PAYMENTS=true                         # staging only — anyone can grant themselves a plan

# ---- GST invoicing (docs/BILLING.md). Leave GSTIN empty if you are not GST-registered → plain receipts without tax ----
GSTIN=                                             # your 15-character GST number (validated at startup)
GST_LEGAL_NAME=ADDABAAZ
BUSINESS_ADDRESS=                                  # printed on invoices; use \n for line breaks
# BUSINESS_STATE=West Bengal                       # only needed when GSTIN is empty
GST_SAC=998439                                     # online content services
GST_RATE=18                                        # percent; prices shown to viewers are GST-inclusive
INVOICE_PREFIX=AB                                  # 1-4 chars → AB/2627/000001
# INVOICE_FOOTER=Subject to Kolkata jurisdiction.
SUPPORT_EMAIL=                                     # shown on invoices and emails

# ---- Email: verification, password reset, receipts and billing notices (any SMTP provider) ----
SMTP_URL=                                          # e.g. smtps://user:pass@smtp.example.com:465 (or smtp://user:pass@smtp.example.com:2525 on Render Free); empty = no mail
MAIL_FROM="ADDABAAZ <billing@addabaaz.in>"
PUBLIC_SITE_URL=https://addabaaz.in                # your public https address, no trailing slash: links in emails AND canonical URLs, sitemap.xml and structured data (docs/SEO.md)

# ---- Google / search (docs/SEO.md) ----
# Only the production site is indexed. NODE_ENV=production turns indexing on; staging/preview copies say "noindex" and robots.txt disallows everything.
# ALLOW_INDEXING=true                              # force on (e.g. a live site not running with NODE_ENV=production) — or =false to keep a production-mode copy out of Google
# GOOGLE_SITE_VERIFICATION=                        # the token from Search Console → Settings → Ownership verification → HTML tag (content="…")
# BING_SITE_VERIFICATION=                          # Bing Webmaster Tools, same idea
# DISABLE_COMPRESSION=true                         # only if your reverse proxy / CDN already gzips responses
EXPIRY_REMINDER_DAYS=3                             # 0 = no "plan ends soon" emails

# ---- Admin console at /admin (docs/ADMIN.md). Admins are normal accounts: `npm run admin -- grant you@example.com` ----
ADMIN_SESSION_HOURS=12                             # console sessions are shorter than viewer sessions
UPLOAD_DIR=./uploads                               # local CACHE of admin uploads (images, subtitles). The real copies are stored in MySQL, so this folder may be emptied by a restart or redeploy; keeping it outside the deployed app only saves re-reading them from MySQL
ADMIN_TOKEN=                                       # OPTIONAL, for scripts/curl only: 24+ random chars (`openssl rand -hex 24`); empty = scripts can't use the admin API
CONTACT_WEBHOOK_URL=                               # optional: POST every contact-form submission (Slack/Zapier/Apps Script)

# ---- docker compose only (root password of the bundled MySQL container) ----
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me

# ---- Accounts, viewing, engagement (docs/ENGAGEMENT.md) ----
STREAM_LIMIT=2                                     # premium screens playing at once per account
REFUND_WINDOW_DAYS=7                               # self-service refund requests; 0 = off
APPLE_CLIENT_ID=                                   # Sign in with Apple: the iOS app's bundle id
APPLE_SERVICE_ID=                                  # Sign in with Apple on the website: a Services ID
VAPID_PUBLIC_KEY=                                  # Web Push:  npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@addabaaz.in
GA4_MEASUREMENT_ID=                                # optional Google Analytics 4 (G-XXXXXXX) — loads only after the visitor accepts
# SENTRY_DSN=                                      # optional server error alerts (also: npm i @sentry/node)

# ---- Backups (npm run backup / restore) ----
# BACKUP_DIR=./backups
# BACKUP_PASSPHRASE=                               # SET THIS: the backup contains emails and password hashes
# BACKUP_KEEP=14
# BACKUP_R2_BUCKET=                                # copy backups to a SEPARATE bucket (never the bucket used for video media)
# BACKUP_R2_ACCOUNT_ID= / BACKUP_R2_ACCESS_KEY_ID= / BACKUP_R2_SECRET_ACCESS_KEY=   # default to the R2_* values
# DISABLE_RATE_LIMIT=true                          # load tests on staging only; ignored when NODE_ENV=production

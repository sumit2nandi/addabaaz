{
  "name": "addabaaz-mobile",
  "version": "2.0.0",
  "private": true,
  "description": "Capacitor shell that packages the ADDABAAZ web app (../www) as native Android & iOS apps",
  "scripts": {
    "add:android": "cap add android && node scripts/patch-android.mjs",
    "add:ios": "cap add ios",
    "sync": "cap sync && node scripts/patch-android.mjs",
    "assets": "capacitor-assets generate --assetPath ../resources --iconBackgroundColor \"#050505\" --iconBackgroundColorDark \"#050505\" --splashBackgroundColor \"#050505\" --splashBackgroundColorDark \"#050505\"",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "run:android": "cap run android",
    "run:ios": "cap run ios",
    "doctor": "cap doctor",
    "android:patch": "node scripts/patch-android.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "@capgo/capacitor-social-login": "^7.20.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0"
  }
}

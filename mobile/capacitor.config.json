{
  "appId": "in.addabaaz.app",
  "appName": "Addabaaz",
  "webDir": "../www",
  "backgroundColor": "#b80000",
  "server": {
    "androidScheme": "https",
    "iosScheme": "https",
    "hostname": "app.addabaaz.in"
  },
  "ios": { "contentInset": "never", "allowsLinkPreview": false, "limitsNavigationsToAppBoundDomains": false },
  "android": { "allowMixedContent": false, "backgroundColor": "#b80000" },
  "plugins": {
    "FirebaseMessaging": { "presentationOptions": ["alert", "badge", "sound"] },
    "SplashScreen": { "launchShowDuration": 0, "launchAutoHide": false, "backgroundColor": "#b80000", "showSpinner": false },
    "StatusBar": { "style": "LIGHT", "backgroundColor": "#b80000", "overlaysWebView": false }
  }
}

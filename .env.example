# Copy to .env (never commit). Load with your process manager / docker --env-file.
PORT=3000
NODE_ENV=production
JWT_SECRET=change-me-to-a-long-random-string      # openssl rand -hex 32   (REQUIRED in production)

# ---- MySQL (5.7+ or 8.x) ----
DATABASE_URL=mysql://addabaaz:change-me@127.0.0.1:3306/addabaaz
# ...or individual settings instead of DATABASE_URL:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=addabaaz
# DB_PASSWORD=change-me
# DB_NAME=addabaaz
# DB_SSL=true                # managed MySQL (RDS, Cloud SQL, Azure, PlanetScale...); DB_SSL_VERIFY=false to skip CA verification (not recommended)
# DB_POOL_SIZE=10
# DB_CREATE=false            # true = CREATE DATABASE IF NOT EXISTS on start (needs that privilege)
# DB_MIGRATE=true            # false = don't auto-migrate on start; run `npm run db:migrate` in your deploy pipeline instead

# ---- Social sign-in (leave blank to disable a provider) — see docs/AUTH.md ----
GOOGLE_CLIENT_ID=                                  # OAuth "Web application" client id (also used by the website button)
GOOGLE_IOS_CLIENT_ID=                              # optional: OAuth iOS client id (native app)
GOOGLE_EXTRA_CLIENT_IDS=                           # optional: more accepted audiences, comma separated (e.g. Android client id)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=                               # server-side only, never ship to clients
FACEBOOK_CLIENT_TOKEN=                             # optional: only needed by the native apps
# FACEBOOK_GRAPH_VERSION=v21.0

# ---- Premium video in a PRIVATE Cloudflare R2 bucket — see docs/PREMIUM.md ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=                                  # API token with "Object Read only" on the bucket
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# R2_ENDPOINT=                                     # optional override (defaults to https://<account>.r2.cloudflarestorage.com)
STREAM_URL_TTL=21600                               # seconds a signed video URL stays valid (default 6 h)
PUBLIC_API_URL=                                    # public https URL of this API (needed for HLS behind a proxy), e.g. https://api.addabaaz.in

CORS_ORIGINS=*                                     # or https://addabaaz.in,https://app.addabaaz.in
TRUST_PROXY=1                                      # number of reverse proxies in front of the app

# ---- Payments (Razorpay, INR) — premium video needs sign-in AND an active paid plan ----
RAZORPAY_KEY_ID=                                   # dashboard → Settings → API Keys (rzp_test_… while testing, rzp_live_… in production)
RAZORPAY_KEY_SECRET=                               # server-side only, never ship to the browser
RAZORPAY_WEBHOOK_SECRET=                           # dashboard → Webhooks → https://<api>/api/v1/payments/webhook, event payment.captured
# Without Razorpay keys: development uses an instant, clearly-labelled DEMO checkout; production has NO checkout (501) unless you set:
# ALLOW_MOCK_PAYMENTS=true                         # staging only — anyone can grant themselves a plan

# ---- GST invoicing (docs/BILLING.md). Leave GSTIN empty if you are not GST-registered → plain receipts without tax ----
GSTIN=                                             # your 15-character GST number (validated at startup)
GST_LEGAL_NAME=ADDABAAZ
BUSINESS_ADDRESS=                                  # printed on invoices; use \n for line breaks
# BUSINESS_STATE=West Bengal                       # only needed when GSTIN is empty
GST_SAC=998439                                     # online content services
GST_RATE=18                                        # percent; prices shown to viewers are GST-inclusive
INVOICE_PREFIX=AB                                  # 1-4 chars → AB/2627/000001
# INVOICE_FOOTER=Subject to Kolkata jurisdiction.
SUPPORT_EMAIL=                                     # shown on invoices and emails

# ---- Email: receipts, refunds, renewal reminders (any SMTP provider) ----
SMTP_URL=                                          # e.g. smtps://user:pass@smtp.example.com:465 — empty = emails are not sent
MAIL_FROM="ADDABAAZ <billing@addabaaz.in>"
PUBLIC_SITE_URL=https://addabaaz.in                # links inside emails
EXPIRY_REMINDER_DAYS=3                             # 0 = no "plan ends soon" emails

# ---- Admin API: refunds, coupons, sales register (docs/BILLING.md). 24+ random chars, e.g. `openssl rand -hex 24`; empty = off ----
ADMIN_TOKEN=
CONTACT_WEBHOOK_URL=                               # optional: POST every contact-form submission (Slack/Zapier/Apps Script)

# ---- docker compose only (root password of the bundled MySQL container) ----
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me

{
  "appId": "in.addabaaz.app",
  "appName": "Addabaaz",
  "webDir": "../www",
  "backgroundColor": "#050505",
  "server": {
    "androidScheme": "https",
    "iosScheme": "https",
    "hostname": "app.addabaaz.in"
  },
  "ios": { "contentInset": "never", "allowsLinkPreview": false, "limitsNavigationsToAppBoundDomains": false },
  "android": { "allowMixedContent": false, "backgroundColor": "#050505" },
  "plugins": {
    "SplashScreen": { "launchShowDuration": 0, "launchAutoHide": false, "backgroundColor": "#050505", "showSpinner": false },
    "StatusBar": { "style": "DARK", "backgroundColor": "#050505", "overlaysWebView": false }
  }
}
